{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/gate.js": {
      "includeFiles": "{index.html,style.css,app.js,model.js,campaign.js,campaign-model.js}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/gate"
    }
  ]
}
